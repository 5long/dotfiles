#!/bin/bash

set -euo pipefail

function main() {
  current_color="$(gsettings get org.gnome.desktop.interface color-scheme)"
  if [[ "$current_color" = "'prefer-dark'" ]]; then
    light_mode
  else
    dark_mode
  fi
}

function light_mode() {
  gsettings set org.gnome.desktop.interface color-scheme prefer-light
  gsettings set org.gnome.desktop.interface gtk-theme Arc
  command lookandfeeltool && lookandfeeltool -a 'Whyme Light' || true
  systemctl --user kill --kill-whom=main --signal=USR2 foot-server.service
  notify-send -a DarkMode -t 1000 "Light mode"
}

function dark_mode() {
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  gsettings set org.gnome.desktop.interface gtk-theme Arc-Dark
  command lookandfeeltool && lookandfeeltool -a 'Whyme Dark' || true
  systemctl --user kill --kill-whom=main --signal=USR1 foot-server.service
  notify-send -a DarkMode -t 1000 "Dark mode"
}

if [[ "$0" = "$BASH_SOURCE" ]]; then
  main
fi
