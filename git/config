# vi: ft=gitconfig
[alias]
	aa = add --all .
	amend = commit --amend -C HEAD
	b = branch -vv
	br = branch
	ca = commit --all
	ci = commit
	cln = clean -Xd
	copytip = !git log -1 --format=%h | wl-copy -n
	dc = diff --cached
	del = rm --cached
	di = diff
	du = diff @{u}
	dus = diff @{u} --stat
	fa = fetch --all --prune
	ff = merge --ff-only
	# fast-forward to the branch in upstream w/ the same name
	fu = !git merge --ff-only "upstream/$(git branch --points-at HEAD --format '%(refname:short)')"
	h = help
	ic = commit -p
	l = log --graph --pretty=grb
	ll = log --graph --pretty=grb --stat
	lu = log --graph --pretty=grb @{u}..
	lus = log --graph --pretty=grb @{u}.. --stat
	mt = mergetool
	ph = push
	pl = pull
	po = push origin
	pp = !git pull && git push
	pu = push upstream
	rb = rebase
	rhu = reset --hard HEAD@{u}
	root = rev-parse --show-toplevel
	rs = restore
	s = status -bs
	sclone = clone --depth 1
	sh = stash
	sl = stash list
	sp = stash show
	sv = stash save -u
	sw = switch
	tip = log --stat -1 -p
[branch]
	autosetupmerge = always
[pretty]
	grb = %C(yellow)%h%Creset %Cgreen(%ai)%Creset %C(bold)<%an>%Creset %C(bold green)%d%Creset %s
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	; syntax-theme = Coldark-Cold
	syntax-theme = Coldark-Dark
	minus-emph-style = normal auto strike
	minus-style = syntax normal strike
	plus-emph-style = syntax normal italic ul
	plus-style = syntax normal italic
[push]
	default = current
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
[merge]
	autoStash = true
	conflictStyle = "diff3"
	defaultToUpstream = true
	tool = vimdiff
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[diff]
	colorMoved = default
	tool = vimdiff
	algorithm = histogram
	mnemonicprefix = true
	indentHeuristic = true
	compactionHeuristic = true
[stash]
	showPatch = true
[blame]
	date = auto:human
[log]
	decorate = true
	date = auto:human
[credential]
	helper = cache --timeout=36000
[rerere]
	enabled = true
[commit]
	verbose = true
[include]
	path = local-config
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true
[advice]
	detachedHead = false
[init]
	defaultBranch = trunk
